{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "*": ["./src/*"],
      "@apptypes/index": ["./src/types/index.ts"],
      "@apputils/index": ["./src/utils/index.ts"],
      "@appservices/index": ["./src/services/index.ts"],
      "@apprepositories/index": ["./src/repositories/index.ts"],
      "@appmodels/index": ["./src/models/index.ts"],
      "@appcli/index": ["./src/cli/index.ts"],
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}